{
  "name": "ravdownloader",
  "version": "3.0.2",
  "description": "RAVdownloader by Colin - Premium Video Downloader",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.colin.ravdownloader",
    "productName": "RAVdownloader",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "extraResources": [
        { "from": "bin/",            "to": "bin/",            "filter": ["**/*"] },
        { "from": "fonts/",          "to": "fonts/",          "filter": ["**/*"] },
        { "from": "LowerThird Files/", "to": "LowerThird Files/", "filter": ["**/*"] }
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        { "from": "bin-mac/",        "to": "bin/",            "filter": ["**/*"] },
        { "from": "fonts/",          "to": "fonts/",          "filter": ["**/*"] },
        { "from": "LowerThird Files/", "to": "LowerThird Files/", "filter": ["**/*"] }
      ]
    },
    "dmg": {
      "title": "RAVdownloader",
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" },
        { "x": 270, "y": 380, "type": "file", "path": "build/Install RAVdownloader.command", "name": "Install RAVdownloader.command" }
      ],
      "window": { "width": 540, "height": 480 }
    },
    "afterPack": "build/afterPack.js",
    "afterSign": "build/afterSign-mac.js",
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RAVdownloader",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "RAVdownloader by Colin",
      "include": "installer.nsh"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "pdfjs-dist": "^3.11.174"
  }
}
